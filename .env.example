# Supabase project settings — Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The public URL this app is deployed at. Used to build the redirect link in
# password-reset emails. Set to http://localhost:3000 for local development
# and to your production URL (e.g. https://your-app.vercel.app) on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — enables richer voice-search/voice-add-item understanding via the
# Gemini API (server-side only, never exposed to the browser). Get a free key
# at https://aistudio.google.com/apikey. If left unset, voice search still
# works fully using a built-in rule-based natural-language parser.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.0-flash

# Optional — wires a real SMS provider into Let's Split's "Send SMS" invite
# channel (src/lib/sms/send-split-invite-sms.ts). Sending an SMS to an Indian
# number requires carrier-level DLT/PE-TM registration (e.g. via MSG91, Jio,
# or Exotel) — a separate business/KYC process, not something this app can
# complete on its own. Leave unset for now: invite links still work fully via
# Copy Link, WhatsApp, and Email, none of which need this.
# SMS_PROVIDER=msg91
